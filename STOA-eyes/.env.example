# Free vision model. Create a key at https://aistudio.google.com/apikey (no card).
# Leave STOA_API_KEY empty to keep the local sample-sheet answers.
STOA_API_KEY=
STOA_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
STOA_MODEL=gemini-3.6-flash
# Redraws a sketch or a messy sheet before counting. A clean drafted sheet skips this.
STOA_IMAGE_MODEL=gemini-3.1-flash-lite-image
